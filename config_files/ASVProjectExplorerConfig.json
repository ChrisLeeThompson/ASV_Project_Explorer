                        "Thickness",
                        "ApplicationFile",
                        "BeamCurrent",
                        "HighVoltage"
                    ]
                },
                "Define Spin Mill Position": {
                    "_comment": "Spin mill template activity.",
                    "ExtractParameters": []
                },
                "Redefine Position": {
                    "_comment": "Spin mill template activity.",
                    "ExtractParameters": [
