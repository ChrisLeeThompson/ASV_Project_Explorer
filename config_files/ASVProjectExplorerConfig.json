                    ]
                },
                "Auto Focus": {
                    "ExtractParameters": [
                        "BeamType",
                        "Type",
                        "SampleCount",
                        "Bitness",
                        "Color",
                        "IsDynamicFocusEnabled",
                        "PositionUpdateStrategyParameters",
                        "DwellTime",
                        "PixelSize",
                        "FovSize",
                        "FrameIntegration",
                        "LineIntegration",
                        "InitialWdStep"
                    ]
                },
                "Auto Contrast Brightness": {
                    "ExtractParameters": [
                        "BeamType",
                        "Type",
                        "Color",
                        "IsDynamicFocusEnabled",
                        "PositionUpdateStrategyParameters",
                        "DwellTime",
                        "PixelSize",
                        "FovSize",
                        "FrameIntegration",
                        "LineIntegration",
                        "QuadMultiplicity",
                        "MaxSaturatedWhitePixelsPct",
                        "MaxSaturatedBlackPixelsPct"
                    ]
                },
                "SDB Imaging": {
                    "ExtractParameters": [
                        "BeamType",
                        "QuadMultiplicity",
                        "ImagingType",
                        "FovSize",
                        "FovOffset",
                        "ZOffset",
                        "PositionUpdateStrategyParameters"
                    ]
                },
                "Pause for Review": {
                    "ExtractParameters": [
                        "BeamType",
                        "ActivityTimeout",
                        "TimeoutBehavior"
                    ]
                },
                "Area for Dynamic Autofunction Positions": {
                    "ExtractParameters": [
                        "SelectedAreaType",
                        "BeamType",
                        "Color",
                        "DwellTime",
                        "FrameIntegration",
                        "LineIntegration",
                        "PixelSize",
                        "FovSize",
                        "PositionUpdateStrategyParameters"
                    ]
                },
                "Define Fiducial": {
                    "ExtractParameters": [
                        "BeamType",
                        "PerformAutofunctions"
                    ]
                },
                "Define Image Reference": {
                    "ExtractParameters": [
                        "BeamType"
                    ]
                },
                "Python Activity": {
                    "ExtractParameters": [
                        "Path"
                    ]
                },
                "Retract Devices": {
                    "ExtractParameters": [
                        "RetractDetectors",
                        "RetractGis"
                    ]
                },
                "Sleep When Done": {
                    "ExtractParameters": []
