    "ExecutionHistoryConfig": {
        "_comment": "Configuration for parsing ExecutionHistory.json from ASV projects. TraversalTypes define the $type hierarchy the parser follows. ActivityTypes define per-activity extraction rules. Activities not listed here will still have CommonFields extracted, but the parser will log a warning for unknown activities.",
        "TraversalTypes": {
            "_comment": "Ordered $type short names the parser follows through Executions.$values to reach ActivityExecutionHistory nodes.",
            "RunLevel": "RunExecutionHistory",
            "SiteLevel": "SiteExecutionHistory",
            "SliceLevel": "SliceExecutionHistory",
            "RecipeLevel": "RecipeExecutionHistory",
            "RepeatedActivityLevel": "RepeatedActivityExecutionHistory",
            "IterationLevel": "ActivityIterationExecutionHistory",
            "ActivityLevel": "ActivityExecutionHistory"
        },
        "CommonFields": {
            "_comment": "Fields extracted from every ActivityExecutionHistory node. Dot-notation paths are resolved relative to the activity node.",
            "Fields": [
                "ActivityName",
                "StartedAt",
                "FinishedAt",
                "Result.Status",
                "Result.Message"
            ]
        },
        "ActivityTypes": {
            "_comment": "Activity-specific extraction rules keyed by ActivityName as it appears in the JSON. FunctionType is used for validation against Result.FunctionType when present. DataPaths are dot-notation paths within Result.Data to extract. IncludeSharpnessData is an optional flag for activities that produce sharpness curve data.",
            "Auto Focus": {
                "FunctionType": "AutoFocus",
                "DataPaths": [
                    "OriginalWd",
                    "FoundWd",
                    "OptimizedWd",
                    "Result"
                ],
                "IncludeSharpnessData": true
            },
            "Auto Stigmator": {
                "FunctionType": "AutoStigmator",
                "DataPaths": [
                    "Result"
                ]
            },
            "Auto Lens Alignment": {
                "FunctionType": "AutoLensAlignment",
                "DataPaths": [
                    "Result"
                ]
            },
            "Auto Source Tilt": {
                "FunctionType": "AutoSourceTilt",
                "DataPaths": [
                    "Result"
                ]
            },
            "Auto Contrast Brightness": {
                "FunctionType": "AutoContrastBrightness",
                "DataPaths": [
                    "Result"
                ]
            },
            "Slicing": {
                "FunctionType": "Slicing",
                "DataPaths": [
                    "FiducialMatch.Score",
                    "FiducialMatch.Threshold"
                ]
            },
            "SDB Imaging": {
                "FunctionType": null,
                "DataPaths": []
            },
            "Pause for Review": {
                "FunctionType": null,
                "DataPaths": []
            },
            "Python Activity": {
                "FunctionType": null,
                "DataPaths": []
            }
        }
    },
    "ConsolidatedMetadataConfig": {
        "_comment": "Configuration for consolidating ASV metadata into a single JSON file.",
        "ProjectName": null,
        "Sites": [
            {
                "SiteName": null,
                "RelativePath": null,
                "Steps": [
                    {
                        "StepName": null,
                        "RelativePath": null,
                        "Images": [
                            {
                                "ImageName": null,
                                "RelativePath": null,
                                "FileNameDetector": null,
                                "FileNameSliceIndex": null,
                                "Metadata": {
                                    "MicroscopeMetadata": {},
                                    "ASVXMLMetadata": {}
                                },
                                "ExecutionHistory": {}
                            }
                        ]
                    }
                ]
            }
        ],
        "ProjectParameters": {}
    },
    "ProjectFileConfig": {
        "_comment": "Configuration for parsing Project.AsvProject files. Defines extraction rules at the site context, recipe context, and activity levels. Data is shown in the Project Parameters tab of the UI.",
        "SiteContext": {
            "_comment": "Fields to extract from each Site.Context subsection. Each key matches a Context subsection name. ExtractFields uses dot-notation paths resolved within that subsection.",
            "Sections": {
                "Slicing": {
                    "ExtractFields": [
                        "SliceThickness",
                        "MilledThickness"
                    ]
                },
                "Specimen": {
                    "ExtractFields": [
                        "SamplePreTilt",
                        "MaterialDepthCorrection"
                    ]
                },
                "Milling": {
                    "ExtractFields": [
                        "MillingDepth",
                        "MillingLength",
                        "WorkingDistance",
                        "UsableCutFaceAreaWidth",
                        "UsableCutFaceAreaHeight",
                        "UsableCutFaceAreaDepth",
                        "OffsetFromFovCenter",
                        "ZOffset",
                        "DetectorsSetup",
                        "Hfw",
                        "OriginalStagePosition",
                        "ScanRotation",
                        "OriginalBeamShift"
                    ]
                },
                "FiducialDefinition": {
                    "ExtractFields": [
                        "IsDefined",
                        "Score",
                        "MatchThresholdModifier"
                    ]
                },
                "FiducialConditions": {
                    "ExtractFields": [
                        "HighVoltage",
                        "BeamCurrent",
                        "StageTilt",
                        "StageRotation",
                        "FovSize",
                        "ZOffset"
                    ]
                },
                "RoughFiducialConditions": {
                    "ExtractFields": [
                        "IsRoughAlignmentEnabled",
                        "HighVoltage",
                        "BeamCurrent",
                        "WorkingDistance",
                        "Hfw"
                    ]
                },
                "RockingMillContext": {
                    "ExtractFields": [
                        "IsRockingMillEnabled",
                        "RockingMillAngles",
                        "BeamIntensity"
                    ]
                },
                "SiteImage": {
                    "ExtractFields": [
                        "Hfw",
                        "Vfw",
                        "Image.RelativePath"
                    ]
                },
                "Limits": {
                    "ExtractFields": [
                        "FieldOfViewLimits"
                    ]
                }
            }
        },
        "RecipeContext": {
            "_comment": "Fields to extract from recipe-level Context sections. The ImagingContext section within SDB imaging recipes contains the resolved imaging conditions.",
            "Sections": {
                "ImagingContext": {
                    "ExtractFields": [
                        "DwellTime",
                        "LineIntegration",
                        "FrameIntegration",
                        "Bitness",
                        "PixelSize",
                        "OpticalUseCase",
                        "BeamCurrent",
                        "HighVoltage",
                        "TiltCorrection",
                        "UseWdCorrection",
                        "UseDigitalYShiftCorrection",
                        "UseBeamYShiftCorrection",
                        "UseStageYShiftCorrection",
                        "YShiftCorrectionDirection",
                        "DriftCorrectionMode",
                        "DriftCorrectionBehavior",
                        "DetectorsSetup",
                        "VacuumOptions"
                    ]
                }
            }
        },
        "ActivityLevel": {
            "_comment": "Extraction rules for activity parameters within each recipe. CommonScheduleFields are extracted from every activity's Schedule. Activities defines per-activity ExtractParameters lists. Use 'ALL' to extract everything except InternalFields. The _DEFAULT_ rule applies to any activity not explicitly listed.",
            "CommonScheduleFields": [
                "IsEnabled",
                "EveryN",
                "CanAutoDisableAfterExecution",
                "RepeatCount"
            ],
            "InternalFields": [
                "AllowedDriftCorrectionModes",
                "MinimumSizeInPixel",
                "IsSquareFovRequired",
                "PixelSizeMaximum",
                "ShortName"
            ],
            "Activities": {
                "Eucentric Finder": {
                    "ExtractParameters": [
                        "TargetTilt"
                    ]
                },
                "Gases Preheating": {
                    "ExtractParameters": []
                },
                "AOI Protective Layer": {
                    "ExtractParameters": [
                        "DepositionThickness",
                        "ReviewPattern",
                        "PadOffsetForCutface",
                        "PadOffsetForMilling",
                        "ApplicationFile",
                        "BeamCurrentDensity",
                        "HighVoltage"
                    ]
                },
                "Fiducial Protective Layer": {
                    "ExtractParameters": [
                        "DepositionThickness",
                        "ReviewPattern",
                        "PrepareFiducialShape",
                        "PadOffsetForMilling",
                        "ApplicationFile",
                        "BeamCurrentDensity",
                        "HighVoltage"
                    ]
                },
                "Create Milling Fiducial": {
                    "ExtractParameters": [
                        "Depth",
                        "ApplicationFile",
                        "BeamCurrent",
                        "HighVoltage"
                    ]
                },
                "Define Milling Fiducial": {
                    "ExtractParameters": []
                },
                "Update Site Image": {
                    "ExtractParameters": [
                        "ShouldExecuteAcb"
                    ]
                },
                "Trench Milling": {
                    "ExtractParameters": [
                        "UseShutter",
                        "DepthCorrectionSlopePart",
                        "DepthCorrectionFlatPart",
                        "LeftTrench",
                        "RightTrench",
                        "RoughCut",
                        "SideTrenchPolishing",
                        "AlignToLeftTrench",
                        "AlignToRightTrench",
                        "MillingOrder",
                        "ApplicationFileSlopePart",
                        "ApplicationFileFlatPart",
                        "ApplicationFileTrenchPolish",
                        "OverlapIntoNextPattern",
                        "BeamCurrent",
                        "HighVoltage"
                    ]
                },
                "Green Clean": {
                    "ExtractParameters": [
                        "UseShutter",
                        "TotalSliceCount",
                        "SliceThickness",
                        "SliceDepth",
                        "SlicesBeforeAreaOfInterest",
                        "ApplicationFile",
                        "OverlapThickness"
                    ]
                },
                "Rocking Mill Test": {
                    "ExtractParameters": [
                        "RockingMillPosition"
                    ]
                },
                "Slicing": {
                    "ExtractParameters": [
                        "UseShutter",
                        "ApplicationFile"
                    ]
                },
                "Spin Milling": {
                    "_comment": "Spin mill template activity.",
                    "ExtractParameters": [
                        "SpinMillType",
                        "DwellTime",
                        "Pitch",
                        "CorrectionFactor",
                        "ApplicationFile",
                        "MaterialTypeApplicationFile",
                        "BeamCurrent",
                        "HighVoltage",
                        "TotalSlices",
                        "NumberOfMillingPositions",
