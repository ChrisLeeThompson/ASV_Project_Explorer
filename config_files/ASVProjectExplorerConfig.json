                    ]
                },
                "Auto Source Tilt": {
                    "ExtractParameters": [
                        "BeamType",
                        "PositionUpdateStrategyParameters",
                        "DwellTime",
                        "PixelSize",
                        "FovSize",
                        "FrameIntegration",
                        "LineIntegration"
                    ]
                },
                "Auto Lens Alignment": {
                    "ExtractParameters": [
                        "BeamType",
                        "WobblingType",
                        "Bitness",
                        "Color",
                        "IsDynamicFocusEnabled",
                        "PositionUpdateStrategyParameters",
                        "DwellTime",
                        "PixelSize",
                        "FovSize",
                        "FrameIntegration",
                        "LineIntegration"
                    ]
                },
                "Auto Stigmator": {
                    "ExtractParameters": [
                        "BeamType",
                        "Type",
                        "Color",
                        "IsDynamicFocusEnabled",
                        "PositionUpdateStrategyParameters",
                        "DwellTime",
                        "PixelSize",
                        "FovSize",
                        "FrameIntegration",
                        "LineIntegration",
                        "WdOffset",
                        "WdBasicCorrectionStep",
                        "StigBasicCorrectionStep",
