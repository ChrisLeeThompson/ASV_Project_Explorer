{
    "_comment": "Configuration file for the ASV Project Explorer UI.",
    "_version": "1.3",
    "TemporaryJSONFileDirectoryName": "_temp_output_JSON_file",
    "TemporaryConsolidatedJSONFileName": "_temp_consolidated_metadata.json",
    "ExportPlotDirectoryName": "Exported_Plots",
    "DefaultSavedJSONFileName": "Consolidated_ASV_Metadata.json",
    "MinifyExportedJSON": true,
    "ShowTrendLineByDefault": true,
    "ASVProjectDirectoryConfig": {
        "_comment": "Configuration for parsing ASV project directories. File names in the validation list must be in the ASV project root directory to begin parsing.",
        "ProjectRootDirectories": {
            "DirectoriesToInclude": [],
            "DirectoriesToExclude": [
                "ProjectLogs",
                "ImageLogs"
            ]
        },
        "SiteSubDirectories": {
            "DirectoriesToInclude": [
                "Acquired"
            ],
            "DirectoriesToExclude": [
                "SetupImages"
            ]
        },
        "ImageLogsDirectories": {
            "DirectoriesToInclude": [
                "Auto Stigmator"
            ],
            "DirectoriesToExclude": [
                "Area Preparation",
                "Milling",
                "Auto Focus"
            ]
        },
        "ParseProjectRootFiles": [
            {
                "Name": "ExecutionHistory.json",
                "Parse": true
            },
            {
                "Name": "Project.AsvProject",
                "Parse": true
            }
        ],
        "ValidationFiles": [
            "ExecutionHistory.json",
            "Metadata.json",
            "Project.AsvProject"
        ]
    },
